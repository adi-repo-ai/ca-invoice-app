{
  "name": "lka-invoices",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:emulator": "firebase emulators:exec --project demo-lka-invoices --only auth,firestore \"vitest run --config vitest.emulator.config.ts\"",
    "test:all": "npm run test && npm run test:emulator",
    "emulators": "firebase emulators:start --project demo-lka-invoices --only auth,firestore --import ./.emulator-data --export-on-exit ./.emulator-data",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed:test": "tsx scripts/seed-test-data.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}

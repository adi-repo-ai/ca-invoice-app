# Copy to `.env` for local development. NEVER commit `.env`.
# ---------------------------------------------------------------------------
# 1) Browser (public) Firebase web config — safe to expose, baked into the
#    build by Vite. In Netlify, set these as build-time environment variables.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lka-invoices.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-lka-invoices
VITE_FIREBASE_APP_ID=demo-app-id
# "true" only for local development against the Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=true

# ---------------------------------------------------------------------------
# 2) SECRET — Netlify Functions only (scope them to "Functions" in Netlify).
#    Take these three values from a service-account key JSON, then delete the
#    JSON file. The private key goes in as one line with literal \n escapes.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-lka-invoices
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# 3) LOCAL ONLY — point the Admin SDK (functions + scripts) at the emulators.
#    NEVER set these in Netlify.
# ---------------------------------------------------------------------------
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---------------------------------------------------------------------------
# 4) OPTIONAL one-time setup code (Netlify, Functions scope, secret). Lets the
#    first signed-in user become ADMIN from the "No access" page without
#    running create-admin. Only works while no ADMIN exists, and only once.
#    Remove it from Netlify once your ADMIN account works.
# ---------------------------------------------------------------------------
# SETUP_CODE=

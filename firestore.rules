rules_version = '2';

// Security rules for the LKA invoice app.
//  * Default deny: anything not matched below is refused.
//  * Roles come from the `role` custom claim ("ADMIN" | "STAFF"), which only
//    the Admin SDK (Netlify Functions / create-admin script) can set.
//  * Issued invoices are immutable except for status/payment fields.
//  * Invoice numbers come from a per-FY counter that can only move forward
//    by exactly one, in the same transaction that issues the invoice.
//  * The audit log is append-only.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'ADMIN'; }
    function isStaff() { return signedIn() && request.auth.token.role in ['ADMIN', 'STAFF']; }
    // Per-person "payments" permission (record payments / receipts). Accounts
    // without the flag (made before it existed) keep it.
    function canPay() { return isStaff() && request.auth.token.get('pay', true) == true; }
    // Owner = ADMIN with the revenue permission (accounts made before it existed count as owners).
    function isOwner() { return isAdmin() && request.auth.token.get('fin', true) == true; }
    function uid() { return request.auth.uid; }
    function docPath(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }

    function str(v, maxLen) { return v is string && v.size() <= maxLen; }
    function nonEmpty(v, maxLen) { return str(v, maxLen) && v.trim().size() > 0; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function paise(v) { return v is int; }

    // Indian Standard Time (UTC+05:30) view of the request time.
    function ist() { return request.time + duration.value(330, 'm'); }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function istDate() { return string(ist().year()) + '-' + pad2(ist().month()) + '-' + pad2(ist().day()); }
    function currentFy() {
      return ist().month() >= 4
        ? string(ist().year()) + '-' + pad2((ist().year() + 1) % 100)
        : string(ist().year() - 1) + '-' + pad2(ist().year() % 100);
    }

    // Default deny for every path not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- firm settings (single doc) ----------
    function validSettings(d) {
      return d.keys().hasOnly(['name', 'tagline', 'proprietor', 'address', 'stateName', 'stateCode', 'phone', 'email',
          'website', 'gstin', 'pan', 'bank', 'defaultTerms', 'brandColor', 'logoDataUrl',
          'signatureDataUrl', 'signatoryName', 'chargeGst',
          'gstRateBp', 'sacCodes', 'invoicePrefix', 'paymentDueDays', 'monthlyGoalPaise', 'templates',
          'updatedAt', 'updatedBy'])
        && nonEmpty(d.name, 200)
        && (!('tagline' in d) || str(d.tagline, 100))
        && (!('proprietor' in d) || str(d.proprietor, 200))
        && str(d.address, 1000)
        && d.stateCode is string && d.stateCode.matches('^[0-9]{2}$')
        && (d.gstin == '' || d.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'))
        && (d.pan == '' || d.pan.matches('^[A-Z]{5}[0-9]{4}[A-Z]$'))
        && d.bank is map
        && str(d.defaultTerms, 4000)
        && d.brandColor is string && d.brandColor.matches('^#[0-9a-fA-F]{6}$')
        // Logo is a base64 data URL kept well under the 1 MiB document limit.
        && (d.logoDataUrl == null || (d.logoDataUrl is string && d.logoDataUrl.size() <= 400000
            && d.logoDataUrl.matches('^data:image/(png|jpeg);base64,.*')))
        && (!('signatureDataUrl' in d) || d.signatureDataUrl == null || (d.signatureDataUrl is string
            && d.signatureDataUrl.size() <= 300000 && d.signatureDataUrl.matches('^data:image/(png|jpeg);base64,.*')))
        && (!('signatoryName' in d) || str(d.signatoryName, 200))
        && (!('chargeGst' in d) || d.chargeGst is bool)
        && d.gstRateBp is int && d.gstRateBp >= 0 && d.gstRateBp <= 2800
        && d.sacCodes is list && d.sacCodes.size() <= 100
        && d.invoicePrefix is string && d.invoicePrefix.matches('^[A-Z]{1,3}$')
        && d.paymentDueDays is int && d.paymentDueDays >= 0 && d.paymentDueDays <= 365
        && (!('monthlyGoalPaise' in d) || (d.monthlyGoalPaise is int && d.monthlyGoalPaise >= 0
            && d.monthlyGoalPaise <= 100000000000))
        && (!('templates' in d) || (d.templates is map
            && d.templates.keys().hasOnly(['invoice', 'reminder', 'receipt'])
            && str(d.templates.get('invoice', ''), 2000)
            && str(d.templates.get('reminder', ''), 2000)
            && str(d.templates.get('receipt', ''), 2000)))
        && d.updatedBy == uid() && d.updatedAt == request.time;
    }

    match /settings/firm {
      allow read: if isStaff();
      allow create, update: if isAdmin() && validSettings(request.resource.data);
    }

    // ---------- user profiles (written only by the Admin SDK) ----------
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      // A signed-in user may only refresh their own "last seen" time.
      allow update: if isStaff() && uid() == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time;
      allow create, delete: if false;
    }

    // ---------- invitations (Google sign-in allow-list, keyed by lower-case email) ----------
    match /invites/{email} {
      allow read: if isAdmin();
      // Only owners add people; other admins can see who is waiting.
      allow create, update: if isOwner()
        && email == email.lower() && email.matches('^[^@\\s]+@[^@\\s]+$')
        && request.resource.data.keys().hasOnly(['email', 'role', 'fin', 'pay', 'invitedBy', 'invitedAt'])
        && request.resource.data.email == email
        && request.resource.data.role in ['ADMIN', 'STAFF']
        // Optional starting permissions; revenue access only for ADMINs.
        && (!('fin' in request.resource.data) || (request.resource.data.fin is bool
              && (request.resource.data.fin == false || request.resource.data.role == 'ADMIN')))
        && (!('pay' in request.resource.data) || request.resource.data.pay is bool)
        && request.resource.data.invitedBy == uid()
        && request.resource.data.invitedAt == request.time;
      allow delete: if isOwner();
    }

    // ---------- personal home-page items (tasks, events, notes, links) ----------
    // Private to the person who created them.
    function ownItem(maxText) {
      let d = request.resource.data;
      return isStaff() && d.ownerUid == uid() && d.updatedAt == request.time
        && d.keys().hasOnly(['ownerUid', 'title', 'text', 'url', 'date', 'time', 'done', 'createdAt', 'updatedAt'])
        && (!('title' in d) || str(d.title, 200))
        && (!('text' in d) || str(d.text, maxText))
        && (!('url' in d) || (d.url is string && d.url.size() <= 1000 && d.url.matches('^https?://.*')))
        && (!('date' in d) || d.date == '' || isDate(d.date))
        && (!('time' in d) || (d.time is string && d.time.matches('^([0-9]{2}:[0-9]{2})?$')))
        && (!('done' in d) || d.done is bool);
    }
    match /{coll}/{itemId} {
      allow read, delete: if coll in ['tasks', 'events', 'notes', 'links'] && isStaff() && resource.data.ownerUid == uid();
      allow create: if coll in ['tasks', 'events', 'notes', 'links'] && ownItem(5000) && request.resource.data.createdAt == request.time;
      allow update: if coll in ['tasks', 'events', 'notes', 'links'] && ownItem(5000)
        && resource.data.ownerUid == uid() && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---------- clients ----------
    function validClient(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'contactPerson', 'email', 'whatsapp',
          'address', 'stateName', 'stateCode', 'gstin', 'pan', 'tags', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && nonEmpty(d.name, 200)
        && d.nameLower == d.name.lower()
        && str(d.contactPerson, 200)
        && str(d.email, 200)
        && d.whatsapp is string && d.whatsapp.matches('^([0-9]{11,15})?$')
        && str(d.address, 1000)
        && str(d.stateName, 100)
        && d.stateCode is string && d.stateCode.matches('^[0-9]{2}$')
        && (d.gstin == '' || d.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'))
        && (d.pan == '' || d.pan.matches('^[A-Z]{5}[0-9]{4}[A-Z]$'))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 12))
        && (!('notes' in d) || str(d.notes, 2000))
        && d.updatedBy == uid() && d.updatedAt == request.time;
    }

    match /clients/{clientId} {
      allow read: if isStaff();
      allow create: if isStaff() && validClient(request.resource.data)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time;
      allow update: if isStaff() && validClient(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      // Invoices keep their own copy of the client's details, so removing a
      // client never changes past invoices. Only ADMINs remove clients.
      allow delete: if isAdmin();
    }

    // ---------- invoices ----------
    function draftKeys() {
      return ['status', 'clientId', 'client', 'items', 'reimbursements', 'gstRateBp', 'taxType',
        'totals', 'amountInWords', 'terms', 'notes', 'includeSignature', 'invoiceDate', 'dueDate',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }
    function issuedOnlyKeys() { return ['number', 'seq', 'fy', 'firm', 'issuedAt', 'issuedBy']; }

    function validInvoiceBody(d) {
      return d.clientId is string // '' = one-off client not saved to the client list
        && d.client is map && nonEmpty(d.client.name, 200)
        && d.items is list && d.items.size() <= 50
        && d.reimbursements is list && d.reimbursements.size() <= 30
        && d.gstRateBp is int && d.gstRateBp >= 0 && d.gstRateBp <= 2800
        && d.taxType in ['INTRA', 'INTER', 'NONE']
        && (!('notes' in d) || str(d.notes, 4000))
        && (!('includeSignature' in d) || d.includeSignature is bool)
        && d.totals is map
        && paise(d.totals.taxablePaise) && paise(d.totals.cgstPaise) && paise(d.totals.sgstPaise)
        && paise(d.totals.igstPaise) && paise(d.totals.taxPaise)
        && paise(d.totals.reimbursementsPaise) && paise(d.totals.roundOffPaise)
        && paise(d.totals.grandTotalPaise) && d.totals.grandTotalPaise >= 0
        && str(d.amountInWords, 500)
        && str(d.terms, 4000)
        && isDate(d.invoiceDate) && isDate(d.dueDate)
        && d.updatedBy == uid() && d.updatedAt == request.time;
    }

    function isNewDraft(d) {
      return d.status == 'DRAFT' && d.keys().hasOnly(draftKeys()) && validInvoiceBody(d)
        && d.createdBy == uid() && d.createdAt == request.time;
    }

    function isDraftEdit(o, d) {
      return o.status == 'DRAFT' && d.status == 'DRAFT'
        && d.keys().hasOnly(draftKeys()) && validInvoiceBody(d)
        && d.createdBy == o.createdBy && d.createdAt == o.createdAt;
    }

    // DRAFT -> ISSUED, assigning the next number from counters/{fy} in the
    // same transaction. getAfter() sees the counter as it will be after the
    // transaction commits; get() sees it before.
    function isIssue(invoiceId, o, d) {
      let counter = docPath('counters', d.fy);
      return o.status == 'DRAFT' && d.status == 'ISSUED'
        && d.keys().hasOnly(draftKeys().concat(issuedOnlyKeys()))
        && validInvoiceBody(d)
        && d.createdBy == o.createdBy && d.createdAt == o.createdAt
        && d.issuedBy == uid() && d.issuedAt == request.time
        && d.invoiceDate == istDate()
        && d.fy == currentFy()
        && d.firm is map
        && d.seq is int && d.seq >= 1 && d.seq <= 9999
        && d.number is string && d.number.size() <= 16
        && d.number.matches('^[A-Z]{1,3}/' + d.fy + '/[0-9]{4}$')
        && int(d.number.split('/')[2]) == d.seq
        && getAfter(counter).data.last == d.seq
        && getAfter(counter).data.lastInvoiceId == invoiceId
        && (exists(counter) ? get(counter).data.last == d.seq - 1 : d.seq == 1);
    }

    function validPayment(p) {
      return p is map
        && p.keys().hasOnly(['date', 'mode', 'amountPaise', 'tdsPaise', 'reference'])
        && isDate(p.date)
        && p.mode in ['BANK_TRANSFER', 'UPI', 'CHEQUE', 'CASH', 'OTHER']
        && p.amountPaise is int && p.amountPaise >= 0
        && p.tdsPaise is int && p.tdsPaise >= 0
        && str(p.reference, 200);
    }

    // ISSUED -> PAID: only status/payment (+ updated stamp) may change.
    function isPayment(o, d) {
      return o.status == 'ISSUED' && d.status == 'PAID'
        && d.diff(o).affectedKeys().hasOnly(['status', 'payment', 'updatedAt', 'updatedBy'])
        && validPayment(d.payment)
        && d.updatedBy == uid() && d.updatedAt == request.time;
    }

    // ISSUED -> CANCELLED (ADMIN only). The number stays reserved.
    function isCancel(o, d) {
      return o.status == 'ISSUED' && d.status == 'CANCELLED'
        && d.diff(o).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt',
            'cancelledBy', 'updatedAt', 'updatedBy'])
        && nonEmpty(d.cancelReason, 1000) && d.cancelReason.trim().size() >= 3
        && d.cancelledBy == uid() && d.cancelledAt == request.time
        && d.updatedBy == uid() && d.updatedAt == request.time;
    }

    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff() && isNewDraft(request.resource.data);
      // Each transition is a separate rule keyed on (old status, new status)
      // so only the relevant checks are evaluated.
      allow update: if isStaff()
        && resource.data.status == 'DRAFT' && request.resource.data.status == 'DRAFT'
        && isDraftEdit(resource.data, request.resource.data);
      allow update: if isStaff()
        && resource.data.status == 'DRAFT' && request.resource.data.status == 'ISSUED'
        && isIssue(invoiceId, resource.data, request.resource.data);
      allow update: if canPay()
        && resource.data.status == 'ISSUED' && request.resource.data.status == 'PAID'
        && isPayment(resource.data, request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'ISSUED' && request.resource.data.status == 'CANCELLED'
        && isCancel(resource.data, request.resource.data);
      // Only ADMINs delete invoices (drafts or numbered).
      allow delete: if isAdmin();
    }

    // ---------- per-FY invoice counters ----------
    // Can only advance by one, and only together with the invoice it numbers.
    function bumpsWithIssuedInvoice(fy) {
      let invId = request.resource.data.lastInvoiceId;
      let after = getAfter(docPath('invoices', invId)).data;
      return request.resource.data.keys().hasOnly(['last', 'lastInvoiceId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && invId is string
        && get(docPath('invoices', invId)).data.status == 'DRAFT'
        && after.status == 'ISSUED'
        && after.fy == fy
        && after.seq == request.resource.data.last;
    }

    match /counters/{fy} {
      allow read: if isStaff();
      allow create: if isStaff() && fy.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.last == 1 && bumpsWithIssuedInvoice(fy);
      allow update: if isStaff()
        && request.resource.data.last == resource.data.last + 1 && bumpsWithIssuedInvoice(fy);
      allow delete: if false;
    }

    // ---------- audit log (append-only) ----------
    match /auditLog/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['invoiceId', 'invoiceNumber', 'action', 'uid',
            'userEmail', 'at', 'details'])
        && request.resource.data.action in ['CREATE', 'EDIT', 'ISSUE', 'PAYMENT', 'CANCEL', 'DELETE', 'SEND_EMAIL', 'SEND_WHATSAPP']
        && request.resource.data.invoiceId is string
        && request.resource.data.uid == uid()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.at == request.time
        && request.resource.data.details is map;
      allow update, delete: if false;
    }
  }
}
